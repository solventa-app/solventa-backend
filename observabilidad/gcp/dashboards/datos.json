    {
      "type": "text",
      "title": "Cómo leer este tablero",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Cloud SQL** (auth y payments) y **Redis** (caché del ACL, sesión causal de rating y cola de reconciliación) salen de Cloud Monitoring. **MongoDB Atlas M0** (risk y rating) no publica métricas del servidor a GCP: se ve en la consola de Atlas y, desde los servicios, como tramos `pymongo` en las trazas. Con el apagado de costos activo, Cloud SQL y Redis aparecen sin datos."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Cloud SQL — CPU",
      "datasource": {
        "type": "stackdriver",
        "uid": "gcp_monitoring"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "gcp_monitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "${proyecto}",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/cpu/utilization"
            ],
            "groupBys": [
              "resource.label.database_id"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "cloud-monitoring-auto",
            "view": "FULL"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
