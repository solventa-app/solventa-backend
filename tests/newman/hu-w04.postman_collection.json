{
  "info": {
    "name": "Solventa - HU-W04 (mesa de siniestros por el gateway)",
    "description": "Backend real de la mesa de siniestros (KAN-27): CLAIMS sobre MongoDB, póliza de POLICY, evidencias en el almacenamiento y orden de pago en PAYMENTS. Requiere `sembrar-siniestros` y CLAIMS con DEMO_REINICIAR=true (solo local). Ver tests/newman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "0.1 CLAIMS vuelve a la semilla (solo local)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{claims_url}}/_demo/reiniciar",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('10 siniestros sembrados', () => pm.expect(pm.response.json().siniestros).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 iniciarSesion como BACKOFFICE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) { iniciarSesion(entrada: $e) { __typename ... on Sesion { token } } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{usuario_backoffice}}\",\n      \"clave\": \"{{clave_backoffice}}\"\n    }\n  }\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const l = 'abcdefghijklmnopqrstuvwxyz'; let s = '';",
                  "for (let i = 0; i < 8; i++) s += l[Math.floor(Math.random() * l.length)];",
                  "pm.collectionVariables.set('alias_asesor', 'asesor.w04.' + s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token_backoffice', cuerpo.data.iniciarSesion.token);",
                  "pm.test('Sesión de BACKOFFICE', () => pm.expect(cuerpo.data.iniciarSesion.__typename).to.eql('Sesion'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 crearUsuario ASESOR (para probar permisos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CrearUsuarioInput!) { crearUsuario(entrada: $e) { __typename } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{alias_asesor}}\",\n      \"clave\": \"{{clave_nuevos}}\",\n      \"rol\": \"ASESOR\"\n    }\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('ASESOR creado', () => pm.expect(cuerpo.data.crearUsuario.__typename).to.eql('Usuario'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.4 iniciarSesion como ASESOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) { iniciarSesion(entrada: $e) { __typename ... on Sesion { token } } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{alias_asesor}}\",\n      \"clave\": \"{{clave_nuevos}}\"\n    }\n  }\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token_asesor', cuerpo.data.iniciarSesion.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Bandeja (CA-W04-01 a 05)",
      "item": [
        {
          "name": "1.1 siniestros: los 10 casos, del más reciente al más antiguo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ siniestros { id radicado estado asegurado { nombre } notificadoEn } }\",\n  \"variables\": {}\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const s = cuerpo.data.siniestros;",
                  "pm.test('10 casos', () => pm.expect(s.length).to.eql(10));",
                  "pm.test('7 en cola (pendientes y en revisión)', () => pm.expect(s.filter(x => ['PENDIENTE','EN_REVISION'].includes(x.estado)).length).to.eql(7));",
                  "pm.test('Ordenados por notificación descendente', () => { const f = s.map(x => Date.parse(x.notificadoEn)); pm.expect(f).to.eql([...f].sort((a, b) => b - a)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 siniestros(estado: APROBADO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ siniestros(estado: APROBADO) { id estado } }\",\n  \"variables\": {}\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Solo aprobados', () => pm.expect(cuerpo.data.siniestros.map(x => x.estado)).to.eql(['APROBADO', 'APROBADO']));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Detalle con póliza real y evidencias firmadas (CA-W04-08 a 16, W04-4, W04-5)",
      "item": [
        {
          "name": "2.1 siniestro(sin-01) con su póliza de POLICY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { siniestro(id: \\\"sin-01\\\") { radicado estado asegurado { nombre documento } poliza { numero estado ramo cobertura { valor moneda } } evidencias { id tipo url geoetiquetada } verificaciones { cumple } venceDictamenEn resolucion { tipo } } }\",\n  \"variables\": {}\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const s = cuerpo.data.siniestro;",
                  "pm.test('Radicado y estado', () => { pm.expect(s.radicado).to.eql('SIN-2026-0141'); pm.expect(s.estado).to.eql('PENDIENTE'); });",
                  "pm.test('Póliza emitida de POLICY con su ramo', () => { pm.expect(s.poliza.numero).to.match(/^SOL-\\d{4}-\\d{6}$/); pm.expect(s.poliza.estado).to.eql('EMITIDA'); pm.expect(s.poliza.ramo).to.include('Vida grupo deudor'); });",
                  "pm.test('5 evidencias, todas con URL firmada', () => { pm.expect(s.evidencias.length).to.eql(5); s.evidencias.forEach(e => pm.expect(e.url).to.include('X-Goog-Signature')); });",
                  "pm.test('Las fotos de la semilla van geoetiquetadas', () => pm.expect(s.evidencias.filter(e => e.tipo === 'FOTO').every(e => e.geoetiquetada)).to.be.true);",
                  "pm.collectionVariables.set('url_evidencia', s.evidencias[0].url);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 la URL firmada descarga la imagen del almacenamiento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{url_evidencia}}",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es una imagen', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//));"
                ]
              }
            }
          ]
        },
        {
