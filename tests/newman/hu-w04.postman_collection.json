                  "const cuerpo = pm.response.json();",
                  "const r = cuerpo.data.derivarSiniestro;",
                  "pm.test('Siniestro EN_REVISION derivado', () => { pm.expect(r.__typename).to.eql('Siniestro'); pm.expect(r.estado).to.eql('EN_REVISION'); pm.expect(r.resolucion.tipo).to.eql('DERIVACION'); pm.expect(r.resolucion.perito.id).to.eql('per-03'); pm.expect(r.resolucion.instrucciones).to.eql('Revisar el daño frontal'); });"
                ]
