              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { peritos(siniestroId: \\\"sin-03\\\") { id nombre tiempoRespuestaDias vencimientoInforme } }\",\n  \"variables\": {}\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const p = cuerpo.data.peritos;",
                  "pm.test('4 peritos con vencimiento a las 5:00 p. m. hora Colombia', () => { pm.expect(p.length).to.eql(4); p.forEach(x => pm.expect(x.vencimientoInforme).to.match(/T17:00:00-05:00$/)); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Derivar (CA-W04-17 a 23)",
