    {
      "name": "4. Aprobar con orden de pago en PAYMENTS (CA-W04-28, W04-6, W04-8)",
      "item": [
        {
          "name": "4.1 aprobarSiniestro(sin-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
