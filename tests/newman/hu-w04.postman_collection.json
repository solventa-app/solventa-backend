            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation { derivarSiniestro(id: \\\"sin-03\\\", peritoId: \\\"per-03\\\", instrucciones: \\\"Revisar el daño frontal\\\") { __typename ... on Siniestro { id estado resolucion { tipo motivo comentario indemnizacion { valor moneda } metodoTransferencia plazoDispersion perito { id nombre } instrucciones vencimientoInforme } } ... on ErrorSiniestro { mensaje } } }\",\n  \"variables\": {}\n}"
            },
            "auth": {
              "type": "bearer",
