            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($v: String) { catalogoPrestadores(versionLocal: $v) { version vigente prestadores { id nombre tipo ciudad latitud longitud activo } } }\",\n  \"variables\": {\n    \"v\": \"{{version_vigente}}\"\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('Vigente por la ruta versionada', () => pm.expect(cuerpo.data.catalogoPrestadores.vigente).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
