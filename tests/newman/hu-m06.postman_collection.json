                  "const cuerpo = pm.response.json();",
                  "pm.test('Código SIN_SESION', () => pm.expect(cuerpo.errors[0].extensions.code).to.eql('SIN_SESION'));",
                  "pm.test('Sin datos', () => pm.expect(cuerpo.data).to.be.null);"
                ]
              }
            }
          ]
        },
