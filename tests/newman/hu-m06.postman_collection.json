              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($v: String) { catalogoPrestadores(versionLocal: $v) { version vigente prestadores { id nombre tipo ciudad latitud longitud activo } } }\",\n  \"variables\": {\n    \"v\": \"2000-01-01.1\"\n  }\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const c = cuerpo.data.catalogoPrestadores;",
                  "pm.test('No vigente', () => pm.expect(c.vigente).to.eql(false));",
                  "pm.test('Los 12 prestadores', () => pm.expect(c.prestadores.length).to.eql(12));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 /v1/graphql/app responde igual",
