          "name": "0.1 iniciarSesion como BACKOFFICE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) {\\n  iniciarSesion(entrada: $e) { __typename ... on Sesion { token usuario { id rol } } ... on ErrorAutenticacion { mensaje } }\\n}\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{usuario_backoffice}}\",\n      \"clave\": \"{{clave_backoffice}}\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const letras = 'abcdefghijklmnopqrstuvwxyz';",
                  "let sufijo = '';",
                  "for (let i = 0; i < 8; i++) sufijo += letras[Math.floor(Math.random() * letras.length)];",
                  "pm.collectionVariables.set('alias_asesor_a', 'asesor.a.' + sufijo);",
                  "pm.collectionVariables.set('alias_asesor_b', 'asesor.b.' + sufijo);",
                  "pm.collectionVariables.set('alias_cliente', 'cliente.h.' + sufijo);",
                  "const base = String(Date.now()).slice(-9);",
                  "pm.collectionVariables.set('doc_a1', '7' + base);",
                  "pm.collectionVariables.set('doc_a2', '8' + base);",
                  "pm.collectionVariables.set('doc_cliente', '9' + base);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const s = cuerpo.data.iniciarSesion;",
                  "pm.test('Sesión de BACKOFFICE', () => pm.expect(s.__typename).to.eql('Sesion'));",
                  "pm.collectionVariables.set('token_backoffice', s.token);"
                ]
              }
            }
          ]
        },
