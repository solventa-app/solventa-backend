    {
      "name": "2. El asesor A ve su historial",
      "item": [
        {
          "name": "2.1 A lista sus consultas: las dos, la más reciente primero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_asesor_a}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($p: Int, $t: Int) {\\n  consultasFuentes(pagina: $p, tamano: $t) {\\n    total pagina tamano\\n    consultas { id creadaEn documentoEnmascarado tipoOferta producto ofertaId\\n      fuentes { id nombre origen estado capturadoEn } }\\n  }\\n}\",\n  \"variables\": {\n    \"p\": 1,\n    \"t\": 10\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const p = cuerpo.data.consultasFuentes;",
                  "pm.test('Sin errores', () => pm.expect(cuerpo.errors).to.be.undefined);",
                  "pm.test('Total 2 en la página 1 de 10', () => { pm.expect(p.total).to.eql(2); pm.expect(p.pagina).to.eql(1); pm.expect(p.tamano).to.eql(10); });",
                  "pm.test('La más reciente primero', () => { pm.expect(p.consultas[0].ofertaId).to.eql(pm.collectionVariables.get('oferta_a2')); pm.expect(p.consultas[1].ofertaId).to.eql(pm.collectionVariables.get('oferta_a1')); });",
                  "pm.test('Documento enmascarado: nunca el completo (regla 6)', () => { pm.expect(p.consultas[0].documentoEnmascarado).to.include('•'); pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('doc_a1')); pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('doc_a2')); });",
                  "pm.test('Tipo de oferta y producto', () => { pm.expect(['COMPLETA', 'PRELIMINAR']).to.include(p.consultas[0].tipoOferta); pm.expect(p.consultas[0].producto).to.eql('VIDA_DEUDOR'); });",
                  "pm.test('Las 5 fuentes con su estado y sin datos', () => { const f = p.consultas[0].fuentes; pm.expect(f).to.have.length(5); f.forEach(x => { pm.expect(['OK', 'CACHE', 'FALLO']).to.include(x.estado); pm.expect(x).to.have.all.keys('id', 'nombre', 'origen', 'estado', 'capturadoEn'); }); });",
                  "pm.collectionVariables.set('consulta_a', p.consultas[0].id);"
                ]
              }
            }
          ]
        },
