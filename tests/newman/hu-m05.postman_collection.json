              "raw": "{\n  \"query\": \"{ siniestro(id: \\\"sin-01\\\") { poliza { id } } }\",\n  \"variables\": {}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('poliza_ajena', cuerpo.data.siniestro.poliza.id);",
                  "pm.test('Póliza ajena', () => pm.expect(cuerpo.data.siniestro.poliza.id).to.not.eql(pm.collectionVariables.get('poliza_cliente')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Reporte (CA-M05)",
      "item": [
        {
          "name": "1.1a solicitarSubidaEvidenciaSiniestro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id: ID!) { solicitarSubidaEvidenciaSiniestro(idReporte: $id, tipoContenido: \\\"image/png\\\", tamanoBytes: 385) {\\n  __typename ... on SubidaArchivo { url metodo encabezados { nombre valor } archivo { id } } ... on ErrorArchivo { codigo mensaje } } }\",\n  \"variables\": {\n    \"id\": \"{{id_reporte}}\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const s = cuerpo.data.solicitarSubidaEvidenciaSiniestro;",
                  "pm.test('URL firmada', () => pm.expect(s.__typename).to.eql('SubidaArchivo'));",
                  "pm.collectionVariables.set('archivo_1', s.archivo.id);",
                  "pm.collectionVariables.set('archivo_1_url', s.url);",
                  "pm.collectionVariables.set('archivo_1_cab', JSON.stringify(s.encabezados));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.1b PUT de la foto a la URL firmada",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{archivo_1_url}}",
              "host": [
                "{{archivo_1_url}}"
              ],
              "path": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "file",
              "file": {
                "src": "tests/newman/archivos/firma-valida.png"
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "JSON.parse(pm.collectionVariables.get('archivo_1_cab')).forEach(c =>",
                  "  pm.request.headers.upsert({ key: c.nombre, value: c.valor }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('la foto quedó en el bucket', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.1c confirmarSubidaArchivo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($id: ID!) { confirmarSubidaArchivo(id: $id) { __typename ... on Archivo { id estado } ... on ErrorArchivo { codigo mensaje } } }\",\n  \"variables\": {\n    \"id\": \"{{archivo_1}}\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('DISPONIBLE', () => pm.expect(cuerpo.data.confirmarSubidaArchivo.estado).to.eql('DISPONIBLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 reportarSiniestro llega PENDIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: ReporteSiniestroInput!) { reportarSiniestro(entrada: $e) { __typename\\n  ... on SiniestroReportado { id radicado estado polizaId fotos resolucion { tipo } }\\n  ... on ErrorSiniestro { mensaje } } }\",\n  \"variables\": {\n    \"e\": {\n      \"idReporte\": \"{{id_reporte}}\",\n      \"polizaId\": \"{{poliza_cliente}}\",\n      \"ocurridoEn\": \"{{ocurrido_en}}\",\n      \"descripcion\": \"Me chocaron por detrás en un semáforo de la 93.\",\n      \"ubicacion\": {\n        \"descripcion\": \"Cra 15 con Calle 93\",\n        \"ciudad\": \"Bogotá\",\n        \"latitud\": 4.6767,\n        \"longitud\": -74.0483\n      },\n      \"fotos\": [\n        {\n          \"archivoId\": \"{{archivo_1}}\",\n          \"tomadaEn\": \"{{foto_tomada_en}}\",\n          \"latitud\": 4.6767,\n          \"longitud\": -74.0483\n        }\n      ]\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const r = cuerpo.data.reportarSiniestro;",
                  "pm.test('SiniestroReportado', () => pm.expect(r.__typename).to.eql('SiniestroReportado'));",
                  "pm.test('PENDIENTE y sin resolución', () => { pm.expect(r.estado).to.eql('PENDIENTE'); pm.expect(r.resolucion).to.be.null; });",
                  "pm.test('Radicado SIN-AAAA-1NNN', () => pm.expect(r.radicado).to.match(/^SIN-\\d{4}-1\\d{3}$/));",
                  "pm.test('1 foto', () => pm.expect(r.fotos).to.eql(1));",
                  "pm.test('Su póliza', () => pm.expect(r.polizaId).to.eql(pm.collectionVariables.get('poliza_cliente')));",
                  "pm.collectionVariables.set('radicado', r.radicado);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 repetir con el mismo idReporte devuelve el mismo caso",
