{
  "info": {
    "name": "Solventa - HU-M05 (reporte de siniestro desde la app, por el gateway)",
    "description": "KAN-278: el CLIENTE demo reporta un siniestro con foto, llega PENDIENTE a la mesa, el BACKOFFICE lo aprueba y la app ve la resolución (v0.37). Requiere las semillas `sembrar-polizas-demo`, `crear-cliente-siniestros-demo` y `sembrar-siniestros`. Corre en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "0.1 iniciarSesion como BACKOFFICE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "web"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) { iniciarSesion(entrada: $e) { __typename ... on Sesion { token } } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{usuario_backoffice}}\",\n      \"clave\": \"{{clave_backoffice}}\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('id_reporte', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('id_reporte_2', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token_backoffice', cuerpo.data.iniciarSesion.token);",
                  "pm.test('Sesión de BACKOFFICE', () => pm.expect(cuerpo.data.iniciarSesion.__typename).to.eql('Sesion'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 iniciarSesion del CLIENTE demo (canal app)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) { iniciarSesion(entrada: $e) { __typename ... on Sesion { token } } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{usuario_cliente_demo}}\",\n      \"clave\": \"{{clave_cliente_demo}}\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.collectionVariables.set('token_cliente', cuerpo.data.iniciarSesion.token);",
                  "pm.test('Sesión de CLIENTE', () => pm.expect(cuerpo.data.iniciarSesion.__typename).to.eql('Sesion'));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 la póliza EMITIDA del cliente demo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/app",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "graphql",
                "app"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ propuestas(estado: EMITIDA) { propuestas { polizaId poliza { vigenciaDesde } } } }\",\n  \"variables\": {}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "const p = cuerpo.data.propuestas.propuestas.find(x => x.polizaId);",
                  "pm.test('Tiene póliza emitida (sembrar-polizas-demo)', () => pm.expect(p).to.not.be.undefined);",
                  "pm.collectionVariables.set('poliza_cliente', p.polizaId);",
                  "// CLAIMS exige desde <= ocurrido <= hasta y no acepta fechas futuras. La póliza demo se crea al sembrar, así que una fecha fija",
                  "// termina antes de su vigencia: la fecha del siniestro se calcula desde la vigencia real (desde 1 s después, porque JS trunca los",
                  "// microsegundos), con tope en una hora atrás y en ahora. La foto se toma 5 minutos después, sin pasar de ahora.",
                  "const ahora = Date.now();",
                  "const desde = p.poliza ? new Date(p.poliza.vigenciaDesde).getTime() + 1000 : ahora - 3600000;",
                  "const ocurrido = Math.min(ahora, Math.max(desde, ahora - 3600000));",
                  "pm.collectionVariables.set('ocurrido_en', new Date(ocurrido).toISOString());",
                  "pm.collectionVariables.set('foto_tomada_en', new Date(Math.min(ahora, ocurrido + 300000)).toISOString());"
                ]
              }
            }
          ]
        },
        {
