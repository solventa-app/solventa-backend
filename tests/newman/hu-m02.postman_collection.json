{
  "info": {
    "name": "Solventa - HU-M02 (sesión con refresh de la app, por el gateway)",
    "description": "KAN-227: iniciarSesion en el canal app trae refresh; renovarSesion rota; el período de gracia (REFRESH_GRACIA_SEGUNDOS, 30 s) acepta un reintento con el refresh anterior si el sucesor no se usó; el reuso con el sucesor ya usado revoca la cadena; cerrarSesion revoca; un refresh web no sirve en la app; una cuenta suspendida no renueva. Corre en orden y de una vez: las carpetas 3 y 4 dependen de que pasen menos de 30 s desde 2.1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparación",
      "item": [
        {
          "name": "0.1 iniciarSesion como BACKOFFICE (web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}/graphql/web"
              ],
              "path": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($e: CredencialesInput!) { iniciarSesion(entrada: $e) { __typename ... on Sesion { token expiraEn refreshToken refreshExpiraEn usuario { id rol estado } } ... on ErrorAutenticacion { codigo mensaje } } }\",\n  \"variables\": {\n    \"e\": {\n      \"usuario\": \"{{usuario_backoffice}}\",\n      \"clave\": \"{{clave_backoffice}}\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Alias único por corrida, solo letras (6+ dígitos seguidos parecen un documento).",
                  "const letras = 'abcdefghijklmnopqrstuvwxyz';",
                  "let sufijo = '';",
                  "for (let i = 0; i < 8; i++) sufijo += letras[Math.floor(Math.random() * letras.length)];",
                  "pm.collectionVariables.set('alias_cliente', 'cliente.m02.' + sufijo);",
                  "pm.collectionVariables.set('doc_cliente', '1' + String(Date.now()).slice(-9));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4 de arquitectura: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('sin errores de GraphQL', () => pm.expect(cuerpo.errors).to.be.undefined);",
                  "const r = cuerpo.data.iniciarSesion;",
                  "pm.test('BACKOFFICE con sesión', () => pm.expect(r.__typename).to.eql('Sesion'));",
                  "pm.test('en la web el refresh no viaja en el cuerpo', () => pm.expect(r.refreshToken).to.be.null);",
                  "pm.collectionVariables.set('token_backoffice', r.token);",
                  "// La cookie httpOnly solventa_refresh trae el refresh del canal web (se usa en 6.1).",
                  "const cookie = pm.cookies.get('solventa_refresh');",
                  "pm.test('el BFF pone la cookie solventa_refresh', () => pm.expect(cookie).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('refresh_web', cookie);"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 crearUsuario CLIENTE (activo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/graphql/web",
              "host": [
                "{{gateway_url}}/graphql/web"
              ],
              "path": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_backoffice}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"mutation($entrada: CrearUsuarioInput!) { crearUsuario(entrada: $entrada) { __typename ... on Usuario { id rol estado } ... on ErrorUsuario { mensaje } } }\",\n  \"variables\": {\n    \"entrada\": {\n      \"usuario\": \"{{alias_cliente}}\",\n      \"clave\": \"{{clave_cliente}}\",\n      \"rol\": \"CLIENTE\",\n      \"nombre\": \"Cliente HU-M02\",\n      \"documentoIdentidad\": \"{{doc_cliente}}\",\n      \"correo\": \"cliente.m02@ejemplo.co\"\n    }\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Regla #4 de arquitectura: nunca un 5xx crudo; GraphQL responde 200 aun con errores.",
                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('sin errores de GraphQL', () => pm.expect(cuerpo.errors).to.be.undefined);",
                  "const r = cuerpo.data.crearUsuario;",
                  "pm.test('CLIENTE activo', () => {",
                  "  pm.expect(r.__typename).to.eql('Usuario');",
                  "  pm.expect(r.estado).to.eql('ACTIVO');",
                  "});",
                  "pm.collectionVariables.set('id_cliente', r.id);"
                ]
              }
            }
          ]
        }
      ]
    },
