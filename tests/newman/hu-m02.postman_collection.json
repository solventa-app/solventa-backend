                  "pm.test('HTTP 200 (nunca un 5xx)', () => pm.response.to.have.status(200));",
                  "const cuerpo = pm.response.json();",
                  "pm.test('sin errores de GraphQL', () => pm.expect(cuerpo.errors).to.be.undefined);",
                  "const r = cuerpo.data.iniciarSesion;",
                  "pm.test('devuelve una Sesion del canal app con refresh', () => {",
                  "  pm.expect(r.__typename).to.eql('Sesion');",
                  "  pm.expect(r.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(r.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(new Date(r.refreshExpiraEn) > new Date(r.expiraEn)).to.be.true;",
                  "});",
                  "pm.collectionVariables.set('r1', r.refreshToken);"
                ]
              }
            }
          ]
