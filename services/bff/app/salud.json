    {"nombre": "under", "peso": 7, "objetivo_latencia_ms": 300},
    {"nombre": "payments", "peso": 7, "objetivo_latencia_ms": 400},
    {"nombre": "almacenamiento", "peso": 6, "objetivo_latencia_ms": 300},
    {"nombre": "consolidador-fuentes", "peso": 4, "objetivo_latencia_ms": 1000}
